generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  ADJUSTMENT
  WITHDRAWAL
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  role         UserRole  @default(CUSTOMER)
  vendor       Vendor?
  orders       Order[]
  wallet       Wallet?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
}

model Vendor {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName      String
  slug           String       @unique
  description    String?
  supportEmail   String?
  supportPhone   String?
  status         VendorStatus @default(PENDING)
  commissionBps  Int          @default(1000)
  products       Product[]
  orderItems     OrderItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
}

model Product {
  id             String      @id @default(cuid())
  vendorId       String
  vendor         Vendor      @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  name           String
  slug           String
  description    String
  category       String
  price          Int
  compareAtPrice Int?
  stock          Int         @default(0)
  images         String[]
  options        Json?
  wholesaleMin   Int?
  active         Boolean     @default(true)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([vendorId, slug])
  @@index([category, active])
  @@index([vendorId, active])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  currency        String        @default("NGN")
  subtotal        Int
  discountTotal   Int           @default(0)
  shippingTotal   Int           @default(0)
  total           Int
  couponCode      String?
  customerName    String
  customerEmail   String
  customerPhone   String
  addressLine     String
  city            String
  state           String
  deliveryNote    String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, paymentStatus])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  productName String
  unitPrice   Int
  quantity    Int
  options     Json?

  @@index([orderId])
  @@index([vendorId])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int
  minimum     Int        @default(0)
  maxDiscount Int?
  usageLimit  Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  expiresAt   DateTime?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int                 @default(0)
  currency     String              @default("NGN")
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id          String                  @id @default(cuid())
  walletId    String
  wallet      Wallet                  @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type        WalletTransactionType
  status      WalletTransactionStatus @default(PENDING)
  amount      Int
  reference   String                  @unique
  description String?
  metadata    Json?
  createdAt   DateTime                @default(now())

  @@index([walletId, createdAt])
  @@index([status, type])
}
